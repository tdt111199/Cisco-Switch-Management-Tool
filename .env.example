# ==============================================================================
# Cisco Historical Unused Port Scanner - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your local deployment.
# IMPORTANT: DO NOT COMMIT REAL CREDENTIALS, PASSWORDS, OR PRIVATE IPS TO GIT!
# ==============================================================================

# Application Meta
APP_NAME="Cisco Historical Unused Port Scanner"
APP_VERSION=1.0.0
APP_ENV=production

# Excel Persistent Storage Paths
# Path to the persistent historical Excel workbook
PORT_HISTORY_FILE=data/port_history.xlsx

# Directory where automatic timestamped backups are archived before every update
BACKUP_DIR=backups/excel_history
AUTO_BACKUP_STORAGE=true

# Scanning & Inactivity Detection Parameters
# Default inactivity threshold in days (e.g., 30, 60, 90, 180)
DEFAULT_THRESHOLD_DAYS=60

# SSH timeout in seconds for Netmiko connections
DEFAULT_SSH_TIMEOUT=20

# Number of concurrent switch scan worker threads
MAX_WORKERS=5

# Logging Parameters
LOG_LEVEL=INFO
LOG_FILE=data/app.log
