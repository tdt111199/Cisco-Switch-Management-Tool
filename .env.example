# ==============================================================================
# Cisco Layer 2 Switch Manager - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local development environment.
# Note: In production GUI usage, switch credentials and parameters are entered 
# via the graphical interface and stored securely in local encrypted storage.

# Application Settings
APP_ENV=production
APP_LOG_LEVEL=INFO

# Network / SSH Session Defaults
DEFAULT_SSH_PORT=22
DEFAULT_SSH_TIMEOUT=15
MAX_CONCURRENT_WORKERS=6

# Storage Paths
DATA_STORAGE_PATH=data/devices.json
BACKUP_DIR=backups
